# Hugging Face access token for gated base models.
# Keep the real token in your shell or local .env file, never in source code.
HF_TOKEN=

# Default base model used by the training and inference scripts.
BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Neo4j connection settings.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional training overrides.
DATA_PATH=non-parameter/phase3_multihop_training/train.chat.phase3_multihop.jsonl
OUTPUT_DIR=non-parameter/phase3_multihop_training/lora_out_llama3_8b_multihop
USE_4BIT=1
MAX_LEN=2048
